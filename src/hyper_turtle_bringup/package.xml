<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hyper_turtle_bringup</name>
  <version>0.0.0</version>
  <description>Bringup package for TurtleBot3 Burger RGB-D Simulation</description>
  <maintainer email="emjdp@example.com">emjdp</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hyper_turtle_description</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_image</depend>
  <depend>robot_state_publisher</depend>
  <depend>rviz2</depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>turtlebot3_bringup</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>hyper_turtle_control</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
